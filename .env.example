# Copy this file to .env. Never commit your actual .env file.

# Voice input: google (internet, no key) or whisper (local after its first model download)
VOICE_INPUT_MODE=google
WHISPER_MODEL=base

# AI conversation: auto (uses the local Claude backend) or offline (built-in commands only)
ASSISTANT_MODE=auto
# Keep the key in this local file; the desktop voice client never sends it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
FENRIS_BACKEND_URL=http://127.0.0.1:8000

# Which brain the backend uses: anthropic (default, cloud, needs the key
# above) or local (an open-weight model you run yourself, no cloud key).
FENRIS_BRAIN_PROVIDER=anthropic
# OpenAI-compatible endpoint for the local brain — Ollama's default shown
# here; for vLLM this is usually http://<host>:8000/v1. Same provider code
# either way, only this URL changes.
FENRIS_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
FENRIS_LOCAL_MODEL=qwen2.5:14b-instruct
# Ollama ignores this; vLLM uses whatever it was launched with.
FENRIS_LOCAL_API_KEY=ollama
FENRIS_LOCAL_MAX_TOKENS=1024
# External path containing a scrypt hash for add-on creation; keep it outside Fenris.
# FENRIS_ADDON_CREATOR_AUTH_FILE=E:\FenrisKeys\addon_creator.hash

# Optional: select a device/voice shown by python voice_check.py
# MICROPHONE_INDEX=0
# VOICE_NAME=Zira

# Wake word: Fenris sleeps until it hears one of these words, then stays awake
# for WAKE_ACTIVE_SECONDS after each exchange. Set WAKE_WORD_ENABLED=false to
# respond to everything it hears instead.
WAKE_WORD_ENABLED=true
# WAKE_WORDS=fenris,fenriss,fenrys,fen ris
# WAKE_ACTIVE_SECONDS=45

# Spoken output: edge = free Microsoft neural voice (internet, auto-fallback
# to the Windows voice); offline = Windows voice only.
TTS_ENGINE=edge
# EDGE_VOICE=en-GB-RyanNeural
# EDGE_RATE=+0%

# Visual HUD (animated orb + live transcript) at http://127.0.0.1:8765
HUD_ENABLED=true
# HUD_PORT=8765
# HUD_AUTO_OPEN=true

# Typed input and uploads from the HUD are attributed to this person when no
# voice has been recognized yet. Set it to your enrolled admin profile name so
# typed and spoken memory stay together (blank = first admin profile).
# OWNER_NAME=loki

# Folders Fenris may list/read files from (comma-separated absolute paths).
# Off by default. Reading a file's contents still needs your explicit go-ahead
# each time; listing does not.
# FENRIS_LOCAL_FOLDERS=C:\Users\you\Documents\FenrisNotes

# Long-term memory: durable facts about each person + semantic recall of past
# messages, injected into context so Fenris remembers people across sessions,
# not just the current transcript. Needs an embeddings endpoint (Ollama:
# ollama pull nomic-embed-text) — if it's unreachable, chat still works, just
# without memory (logged once). Set to false to fully revert /chat to today's
# behavior with none of this.
FENRIS_SEMANTIC_MEMORY=true
# Reuses FENRIS_LOCAL_BASE_URL/FENRIS_LOCAL_API_KEY by default — works even
# when FENRIS_BRAIN_PROVIDER=anthropic, since embeddings are a separate call.
# FENRIS_EMBED_BASE_URL=http://127.0.0.1:11434/v1
FENRIS_EMBED_MODEL=nomic-embed-text
# FENRIS_EMBED_API_KEY=ollama
FENRIS_MEMORY_TOPK=6
FENRIS_MEMORY_MIN_SCORE=0.35
FENRIS_MEMORY_FACT_CAP=40

# Proactive delivery: Fenris speaking unprompted (reminders coming due),
# without the wake word. False fully disables the background poll thread —
# no behavior change from today at all.
PROACTIVE_ENABLED=true
PROACTIVE_POLL_SECONDS=30
# Local HH:MM window during which proactive speech is suppressed entirely.
PROACTIVE_QUIET_START=22:00
PROACTIVE_QUIET_END=08:00

# Initiative: Fenris bringing things up on its own — not a reminder you set,
# but something it noticed from stored facts/recent conversation ("you
# mentioned wanting to email Sam yesterday, still want to?"). Off by default
# on purpose; the whole design leans toward silence — most considerations are
# expected to produce nothing. Delivered through the same proactive voice
# loop above, so it's also gated by PROACTIVE_QUIET_START/END and never
# speaks over an active turn.
FENRIS_INITIATIVE=false
# Seconds between consideration passes.
FENRIS_INITIATIVE_INTERVAL=1800
# Minimum hours between considering the same person again, win or lose.
FENRIS_INITIATIVE_MIN_HOURS=4
# Max un-delivered initiatives allowed to stack up per person.
FENRIS_INITIATIVE_MAX_PENDING=1
# Recent messages included as context per consideration.
FENRIS_INITIATIVE_HISTORY_N=20

# !! Acting on this computer — read this before setting any of these. !!
# Each one is empty/off by default, meaning Fenris cannot open anything, run
# anything, or write anything until you name it here. Every action is still
# admin-only and confirmed by you individually every single time regardless —
# but only put here exactly what you actually want Fenris able to do; treat
# these three lines as real permission grants, not convenience settings.

# name=path pairs, semicolon-separated. Only these exact names can be opened
# (as "open notepad", never an arbitrary path) — subprocess, no shell.
# FENRIS_ALLOWED_APPS=notepad=notepad.exe;browser=C:\Program Files\Google\Chrome\Application\chrome.exe

# id=argv-template pairs, semicolon-separated. Only these exact command_ids
# can run, and only as a fixed argument list (never a shell) — there is no
# free-form/arbitrary command execution at all, by design.
# FENRIS_ALLOWED_COMMANDS=ipconfig=ipconfig /all;ping_google=ping -n 4 google.com

# Folders Fenris may write/append files into (semicolon-separated absolute
# paths) — separate from FENRIS_LOCAL_FOLDERS above, so you can grant read
# without write on the same folder. Never point this at system directories,
# your home folder root, or the Fenris project itself.
# FENRIS_WRITABLE_FOLDERS=C:\Users\you\Documents\FenrisNotes
